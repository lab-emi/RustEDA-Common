// timed
module mini (clk_i, rst_ni, a_i, b_i, q_o);
 input clk_i, rst_ni, a_i, b_i;
 output q_o;
 wire en;
 wire gclk;
 wire rstn;
 wire hf;
 wire q0;
 wire q1;
 wire q7;
 wire r0q;
 wire r0n;
 wire d0;
 wire d1;
 wire q2;
 wire d2;
 wire q3;
 wire d3;
 wire q4;
 wire d4;
 wire q5;
 wire d5;
 wire q6;
 wire d6;
 wire d7;
 AND2X1 gate (.A(clk_i), .B(en), .Y(gclk));
 BUFX1 rbuf (.A(rst_ni), .Y(rstn));
 NAND2X1 u_hf (.A(a_i), .B(b_i), .Y(hf));
 INVX1 u_en (.A(q0), .Y(en));
 BUFX2 u_o (.A(q1), .Y(q_o));
 DFFX1 r0 (.CK(clk_i), .D(q7), .RB(rst_ni), .Q(r0q));
 INVX1 u_r0 (.A(r0q), .Y(r0n));
 DFFX1 f0 (.CK(gclk), .D(d0), .RB(rstn), .Q(q0));
 NAND2X1 g0 (.A(hf), .B(q1), .Y(d0));
 DFFX1 f1 (.CK(gclk), .D(d1), .RB(rstn), .Q(q1));
 NAND2X1 g1 (.A(hf), .B(q2), .Y(d1));
 DFFX1 f2 (.CK(gclk), .D(d2), .RB(rstn), .Q(q2));
 NAND2X1 g2 (.A(hf), .B(q3), .Y(d2));
 DFFX1 f3 (.CK(gclk), .D(d3), .RB(rstn), .Q(q3));
 NAND2X1 g3 (.A(hf), .B(q4), .Y(d3));
 DFFX1 f4 (.CK(gclk), .D(d4), .RB(rstn), .Q(q4));
 NAND2X1 g4 (.A(hf), .B(q5), .Y(d4));
 DFFX1 f5 (.CK(gclk), .D(d5), .RB(rstn), .Q(q5));
 NAND2X1 g5 (.A(hf), .B(q6), .Y(d5));
 DFFX1 f6 (.CK(gclk), .D(d6), .RB(rstn), .Q(q6));
 NAND2X1 g6 (.A(hf), .B(q7), .Y(d6));
 DFFX1 f7 (.CK(gclk), .D(d7), .RB(rstn), .Q(q7));
 NAND2X1 g7 (.A(hf), .B(q0), .Y(d7));
endmodule
