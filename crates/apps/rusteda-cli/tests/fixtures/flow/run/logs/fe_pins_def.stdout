VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN mini ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 200000 120000 ) ;
COMPONENTS 24 ;
- gate AND2X1 + PLACED ( 12000 10080 ) N ;
- rbuf BUFX1 + PLACED ( 22500 10080 ) N ;
- u_hf NAND2X1 + PLACED ( 32580 10080 ) N ;
- u_en INVX1 + PLACED ( 42660 10080 ) N ;
- u_o BUFX2 + PLACED ( 52320 10080 ) N ;
- r0 DFFX1 + PLACED ( 62820 10080 ) N ;
- u_r0 INVX1 + PLACED ( 77520 10080 ) N ;
- f0 DFFX1 + PLACED ( 87180 10080 ) N ;
- g0 NAND2X1 + PLACED ( 12000 23520 ) N ;
- f1 DFFX1 + PLACED ( 22080 23520 ) N ;
- g1 NAND2X1 + PLACED ( 36780 23520 ) N ;
- f2 DFFX1 + PLACED ( 46860 23520 ) N ;
- g2 NAND2X1 + PLACED ( 61560 23520 ) N ;
- f3 DFFX1 + PLACED ( 71640 23520 ) N ;
- g3 NAND2X1 + PLACED ( 86340 23520 ) N ;
- f4 DFFX1 + PLACED ( 12000 36960 ) N ;
- g4 NAND2X1 + PLACED ( 26700 36960 ) N ;
- f5 DFFX1 + PLACED ( 36780 36960 ) N ;
- g5 NAND2X1 + PLACED ( 51480 36960 ) N ;
- f6 DFFX1 + PLACED ( 61560 36960 ) N ;
- g6 NAND2X1 + PLACED ( 76260 36960 ) N ;
- f7 DFFX1 + PLACED ( 86340 36960 ) N ;
- g7 NAND2X1 + PLACED ( 12000 50400 ) N ;
- u_ram RAM8 + FIXED ( 120000 60000 ) N ;
END COMPONENTS
PINS 6 ;
- clk_i + NET clk_i + DIRECTION INPUT + USE SIGNAL + PORT + LAYER Metal3 ( 0 0 ) ( 380 380 ) + PLACED ( 0 30000 ) N ;
- rst_ni + NET rst_ni + DIRECTION INPUT + USE SIGNAL + PORT + LAYER Metal3 ( 0 0 ) ( 380 380 ) + PLACED ( 0 60000 ) N ;
- a_i + NET a_i + DIRECTION INPUT + USE SIGNAL + PORT + LAYER Metal3 ( 0 0 ) ( 380 380 ) + PLACED ( 50000 0 ) N ;
- b_i + NET b_i + DIRECTION INPUT + USE SIGNAL + PORT + LAYER Metal3 ( 0 0 ) ( 380 380 ) + PLACED ( 90000 0 ) N ;
- q_o + NET q_o + DIRECTION OUTPUT + USE SIGNAL + PORT + LAYER Metal3 ( 0 0 ) ( 380 380 ) + PLACED ( 199620 50000 ) N ;
- VDD + NET VDD + DIRECTION INOUT + USE POWER ;
END PINS
NETS 27 ;
- clk_i ( PIN clk_i ) ( gate A ) ( r0 CK ) + USE SIGNAL ;
- rst_ni ( PIN rst_ni ) ( rbuf A ) ( r0 RB ) + USE SIGNAL ;
- a_i ( PIN a_i ) ( u_hf A ) + USE SIGNAL ;
- b_i ( PIN b_i ) ( u_hf B ) + USE SIGNAL ;
- q_o ( PIN q_o ) ( u_o Y ) + USE SIGNAL ;
- en ( gate B ) ( u_en Y ) + USE SIGNAL ;
- gclk ( gate Y ) ( f0 CK ) ( f1 CK ) ( f2 CK ) ( f3 CK ) ( f4 CK ) ( f5 CK ) ( f6 CK ) ( f7 CK ) + USE SIGNAL ;
- rstn ( rbuf Y ) ( f0 RB ) ( f1 RB ) ( f2 RB ) ( f3 RB ) ( f4 RB ) ( f5 RB ) ( f6 RB ) ( f7 RB ) + USE SIGNAL ;
- hf ( u_hf Y ) ( g0 A ) ( g1 A ) ( g2 A ) ( g3 A ) ( g4 A ) ( g5 A ) ( g6 A ) ( g7 A ) + USE SIGNAL ;
- q0 ( u_en A ) ( f0 Q ) ( g7 B ) + USE SIGNAL ;
- q1 ( u_o A ) ( g0 B ) ( f1 Q ) + USE SIGNAL ;
- q7 ( r0 D ) ( g6 B ) ( f7 Q ) + USE SIGNAL ;
- r0q ( r0 Q ) ( u_r0 A ) + USE SIGNAL ;
- r0n ( u_r0 Y ) + USE SIGNAL ;
- d0 ( f0 D ) ( g0 Y ) + USE SIGNAL ;
- d1 ( f1 D ) ( g1 Y ) + USE SIGNAL ;
- q2 ( g1 B ) ( f2 Q ) + USE SIGNAL ;
- d2 ( f2 D ) ( g2 Y ) + USE SIGNAL ;
- q3 ( g2 B ) ( f3 Q ) + USE SIGNAL ;
- d3 ( f3 D ) ( g3 Y ) + USE SIGNAL ;
- q4 ( g3 B ) ( f4 Q ) + USE SIGNAL ;
- d4 ( f4 D ) ( g4 Y ) + USE SIGNAL ;
- q5 ( g4 B ) ( f5 Q ) + USE SIGNAL ;
- d5 ( f5 D ) ( g5 Y ) + USE SIGNAL ;
- q6 ( g5 B ) ( f6 Q ) + USE SIGNAL ;
- d6 ( f6 D ) ( g6 Y ) + USE SIGNAL ;
- d7 ( f7 D ) ( g7 Y ) + USE SIGNAL ;
END NETS
END DESIGN
